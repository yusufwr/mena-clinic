# ============================================================
# Mena Clinic - Production Environment Configuration
# ============================================================

# --- Domain & SSL (Used for CORS and Proxies) ---
CLINIC_DOMAIN=menaclinic.com
PATIENT_PORTAL_DOMAIN=portal.menaclinic.com
ADMIN_PANEL_DOMAIN=admin.menaclinic.com
API_DOMAIN=api.menaclinic.com

# --- Host Port Mappings for Nginx Proxy Manager ---
WEB_PORT=3000
API_PORT=3001
PATIENT_PORT=3002
ADMIN_PORT=3003

# --- MySQL Database Configuration ---
MYSQL_DATABASE=mena_clinic
MYSQL_USER=mena_user
MYSQL_PASSWORD=MenaSecurePassword2026!
MYSQL_ROOT_PASSWORD=MenaRootSecurePassword2026!
DATABASE_URL="mysql://mena_user:MenaSecurePassword2026!@mysql:3306/mena_clinic"

# --- API Security & Authentication ---
JWT_SECRET=mena_clinic_super_secret_jwt_key_2026_production_change_me!
TRUST_PROXY=true
REQUEST_BODY_LIMIT=10mb
CORS_ORIGIN=https://menaclinic.com,https://portal.menaclinic.com,https://admin.menaclinic.com,http://localhost:3000,http://localhost:3002,http://localhost:3003
