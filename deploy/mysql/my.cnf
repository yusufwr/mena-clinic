[mysqld]
# Reserve 50-70% of RAM for InnoDB on a dedicated database server.
# On a shared web/database VPS, calculate against memory left after Node workers.
innodb_buffer_pool_size = 4G
innodb_buffer_pool_instances = 4
max_connections = 400
table_open_cache = 4000
thread_cache_size = 64
skip_name_resolve = ON
slow_query_log = ON
long_query_time = 1
