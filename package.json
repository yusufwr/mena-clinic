{
  "name": "mena-clinic-aleppo",
  "version": "1.0.0",
  "description": "Enterprise-grade Clinic Management System (HIS/EMR) for Mena Clinic Aleppo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "audit:verify": "node audit/verify-system.cjs",
    "build:local": "npm run build --prefix clinic-system && npm run build --workspace=apps/admin-panel",
    "install:all": "npm install && npm run install --workspaces",
    "dev:web": "npm run dev --prefix clinic-system",
    "dev:admin": "npm run dev --workspace=apps/admin-panel",
    "dev": "concurrently -n \"WEB-3000,ADMIN-3003\" -c \"cyan,magenta\" \"npm run dev:web\" \"npm run dev:admin\"",
    "build:all": "npm run build --workspaces",
    "start:production": "npm run start --workspace=apps/api",
    "start:cluster": "pm2-runtime ecosystem.config.cjs",
    "prisma:generate": "npm run prisma:generate --workspace=apps/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/api",
    "prisma:seed": "npm run prisma:seed --workspace=apps/api",
    "setup:db": "npm run setup:db --workspace=apps/api"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
